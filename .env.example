# 100BeautiesLab. Creations DB — ローカル環境変数サンプル
#
# このファイルをコピーして `.env` を作成し、各値を設定してください。
#   cp .env.example .env
# `.env` は .gitignore 対象（コミットされません）。鍵は絶対にコミットしないこと。

# --- DeepL 翻訳 API ---
# DeepL API の認証キー。無料プランのキーは末尾が ":fx"。
# tools/deepl/sync-glossary.mjs / evaluate-translations.mjs が参照します。
# 取得: https://www.deepl.com/ja/your-account/keys
# （Cowork の DeepL コネクタ経由で翻訳・用語集作成する場合はこのキーは不要です）
DEEPL_API_KEY=
