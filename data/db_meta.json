    "#Works_DestinyFoxRecords": {
      "Title_JP": "運命線狐の記録\nフィジカル9",
      "CalendarColorId": "5",
      "Title_EN": "Destiny Fox's Records\nPhysical 9",
      "Works_Code": "DFR",
      "OldTitles": [
        {
          "Title_JP": "運命線探偵上官ラジアンの記録",
          "Title_EN": "Destiny Detective Superintendent: RadianN's Records",
          "ArchivedYear": 2021
        }
      ],
      "Works_Summary_JP": "弊創作を執筆している「ラジアン」の仲間たち。\n主に科学単位や数学用語に基づいた獣人のキャラクターからなる。\nちなみに、当タイトルのいう「ラジアン」とは作者の２代目代理のことである。",
      "Works_Summary_EN": "Companions of 'RadianN', the author writing this creative series.\nThey mainly consist of beastfolk characters themed around scientific units and mathematical terms.\nIn this title, 'RadianN' refers to the author's second-generation proxy character.",
      "$DetailLayout": {
        "headerPills": ["Progress"],
