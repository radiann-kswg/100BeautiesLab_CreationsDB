    "#DB_SemiPrimary": {
      "DB_Label_JP": "準一次創作",
      "DB_Label_EN": "Semi-Primary",
      "DB_Summary": "ナンバーテールズのうち、公式の下でアンソロジーとしてデザインされたキャラクターで、こちらは一次創作に準ずる括りとする。\n公式一次創作作品の延長として登場する番号やゾロ目(マスターナンバーとしての33および111の倍数)や一部キリ番などの非負整数を主とした数秘をそれぞれ有している。",
      "DB_Summary_EN": "Among NumberTales, characters designed as an anthology under official supervision and treated as quasi-primary creations.\nEach one has numerology centered on non-negative integers, including numbers extended from official primary works, repdigits (33 and multiples of 111 as master numbers), and selected milestone numbers.",
      "StoryEra": {
        "FromEra": [
          { "EraGen": 9, "YearInEra": 3 },
          { "EraGen": 8, "YearInEra": 6 },
          { "byRealYear": 2050 }
        ],
        "ToEra": [
          { "EraGen": 9, "YearInEra": 5 },
          { "EraGen": 8, "YearInEra": 8 },
          { "byRealYear": 2052 }
        ],
        "InEra": [{ "EraGen": 8, "YearInEra": 6 }, { "byRealYear": 2050 }],
        "StoryEraAbout_JP": "第9創世紀3〜5年(第8創世紀6〜8年,西暦2050〜2052年相当)",
        "StoryEraAbout_EN": "between WDCE.IX.3-5(Equivalent to between: WDCE.VIII.6-8, DC.2050-2052)"
      },
      "_Commons": {
        "Belonging": ["百花繚乱研究所"],
        "RaceType": "PortableHumanoid(TaleBeastType)"
      }
    },
    "#DB_SelfSecondary": {
      "DB_Label_JP": "セルフ二次創作",
      "DB_Label_EN": "Self-Secondary",
      "DB_Summary": "ナンバーテールズのうち、公式または公式指導の下で副次創作としてデザインされたキャラクターで、こちらは二次創作に準ずる括りとする。\nゾロ目(111の倍数)などの予約された番号を除く101以上999未満の非負整数である数秘をそれぞれ有している。",
      "DB_Summary_EN": "Among NumberTales, characters designed as derivative creations under official production or official guidance, treated as quasi-secondary creations.\nEach one has numerology based on a non-negative integer from 101 to below 999, excluding reserved numbers such as repdigits (multiples of 111).",
