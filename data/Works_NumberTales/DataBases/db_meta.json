    "#DB_Secondary": {
      "DB_Label_JP": "二次創作",
      "DB_Label_EN": "Secondary",
      "DB_Summary": "ナンバーテールズのうち、公認された副次創作作品内で登場した二次創作キャラクター。\n有している数秘の制約については、原則としてガイドラインに準拠したものであるならば概ね何でもよい。",
      "DB_Summary_EN": "Among NumberTales, secondary-creation characters appearing in approved derivative works.\nAs for numerology constraints, almost any setting is acceptable in principle as long as it follows the guidelines.",
      "_Secondaries": [
        {
          "sec_Category": "自創作キャラ化企画",
          "sec_DesignedBy": ["RadianN"],
          "sec_SeriesTitle": "ナンバーテールズ化企画",
          "_Commons": {
            "Belonging": [],
            "RaceType": [
              {
                "value": "PortableHumanoid(TaleBeastType)",
                "about_JP": "自創作キャラ化の便宜上",
                "about_EN": "For the convenience of being adapted into our creations"
              },
              {
                "about_JP": "実際の種族はわずかに異なる部分あり",
                "about_EN": "The actual species may differ slightly"
              }
            ]
          }
        },
        {
          "sec_Category": "共同二次創作",
          "sec_DesignedBy": ["Atast"],
          "sec_SeriesTitle": "ヘキサデミカル・テールズ",
          "SecondarySummary_JP": "散狐アタストさんにより原案がキャラデザされ、現在はラジアン(柏木主税)に権利を譲渡されている。\n異世界から(散狐アタストさんの代理キャラである)「エイゼルベット」によりナンバーテールズを基にして生み出され、(同じく二次創作観測キャラである)「シグマ.クロステールズ」により百花繚乱研究所のある世界へ仲介された、十六進拡張用の数字を持つ６体のバーチャル同位体。現在は百花繚乱研究所に託され、研究開発の一要因として活動している。",
          "StoryEra": {
            "InEra": [
              { "EraGen": 9, "YearInEra": 4 },
              { "EraGen": 8, "YearInEra": 7 },
              { "byRealYear": 2051 }
            ],
            "StoryEraAbout_JP": "第9創世紀4年(第8創世紀7年,西暦2051年相当)周辺",
            "StoryEraAbout_EN": "in around WDCE.IX.4(Equivalent to in around: WDCE.VIII.7, DC.2051)"
          },
          "_Commons": {
            "Belonging": ["百花繚乱研究所", "エイゼルベットの観測世界"],
            "RaceType": "PortableHumanoid(TaleBeastType,SoftwareBody)"
          }
        },
        {
          "sec_Category": "セルフ三次創作",
          "sec_DesignedBy": ["RadianN"],
          "sec_SeriesTitle": "ヘキサデミカル・テールズ(ナンバーテールズ公式副次創作版)",
          "SecondarySummary_JP": "散狐アタストさんにより原案がキャラデザされた「ヘキサデミカル・テールズ」をもとにナンバーテールズの公式副次創作としてキャラの構想を拡張した。\n百花繚乱研究所と「エイゼルベット」によりある世界からあらゆる\"観測\"を経て誕生した、特殊な十六進数を持つナンバーテールズ同位体。百花繚乱研究所にて研究開発の一要因として活動している。",
          "StoryEra": {
            "InEra": [
              { "EraGen": 9, "YearInEra": 5 },
              { "EraGen": 8, "YearInEra": 8 },
              { "byRealYear": 2052 }
            ],
            "StoryEraAbout_JP": "第9創世紀5年(第8創世紀8年,西暦2052年相当)周辺",
            "StoryEraAbout_EN": "in around WDCE.IX.5(Equivalent to in around: WDCE.VIII.8, DC.2052)"
          },
          "_Commons": { "isPrivate": true }
        },
        {
          "sec_Category": "共同二次創作",
          "sec_DesignedBy": ["RadianN", "Atast"],
          "sec_SeriesTitle": "D-Vines(ディ-ヴァインズ)",
          "SecondarySummary_JP": "散狐アタストさんの提案により考案された。\nシンフォニー.XVI(ゼクズィン)に所属する「錦野舞」によりナンバーテールズの互換プロダクションとして開発された、胴部襷掛け方向に上下体の乖離・組み換え再接続が可能なカスタマイズ特化型ディビエイタブルヒューマノイド。上下の組み換え次第で性格に変化が生じるため、個体の外見デザイン以上のキャラクターバリエーションを有することが特徴。",
          "StoryEra": {
            "InEra": [
              { "EraGen": 9, "YearInEra": 5 },
              { "EraGen": 8, "YearInEra": 8 },
              { "byRealYear": 2052 }
            ],
            "StoryEraAbout_JP": "第9創世紀5年(第8創世紀8年,西暦2052年相当)周辺",
            "StoryEraAbout_EN": "in around WDCE.IX.5(Equivalent to in around: WDCE.VIII.8, DC.2052)"
          },
          "_Commons": {
            "Belonging": ["シンフォニー.XVI(ゼクズィン)"],
            "RaceType": "DeviatableHumanoid(TaleBeastType)",
            "isPrivate": true
          }
        }
      ],
