    "#DB_Secondary": {
      "DB_Label_JP": "二次創作",
      "DB_Label_EN": "Secondary",
      "DB_Summary": "ナンバーテールズのうち、公認された副次創作作品内で登場した二次創作キャラクター。\n有している数秘の制約については、原則としてガイドラインに準拠したものであるならば概ね何でもよい。",
      "DB_Summary_EN": "Among NumberTales, secondary-creation characters appearing in approved derivative works.\nAs for numerology constraints, almost any setting is acceptable in principle as long as it follows the guidelines.",
      "_Secondaries": [
        {
          "sec_Category": "共同二次創作",
          "sec_DesignedBy": ["Atast"],
          "sec_SeriesTitle": "ヘキサデミカル-テールズ",
          "SecondarySummary_JP": "散狐アタストさんにより原案がキャラデザされ、現在はラジアン(柏木主税)に権利を譲渡されている。\n異世界から(散狐アタストさんの代理キャラである)「エイゼルベット」によりナンバーテールズを基にして生み出され、(同じく二次創作観測キャラである)「シグマ.クロステールズ」により百花繚乱研究所のある世界へ仲介された、十六進拡張用の数字を持つ６体のバーチャル同位体。現在は百花繚乱研究所に託され、研究開発の一要因として活動している。",
          "StoryEra": {
            "InEra": [
              { "EraGen": 9, "YearInEra": 4 },
