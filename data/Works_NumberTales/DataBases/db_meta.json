            "StoryEraAbout_EN": "in around WDCE.IX.4(Equivalent to in around: WDCE.VIII.7, DC.2051)"
          },
          "_Commons": {
            "Progress": "accepted",
            "Belonging": [
              { "Faction": "百花繚乱研究所" },
              { "Faction": "エイゼルベットの観測世界" }
            ],
            "RaceType": "PortableHumanoid(TaleBeastType,SoftwareBody)",
            "isTriple": false
          },
          "AI_Optout": true
        },
        {
          "sec_Category": "セルフ三次創作",
          "sec_DesignedBy": ["RadianN"],
          "sec_SeriesTitle": "公式版ヘキサデミカル-テールズ",
          "SecondarySummary_JP": "散狐アタストさんにより原案がキャラデザされた「ヘキサデミカル・テールズ」をもとにナンバーテールズの公式副次創作としてキャラの構想を拡張した。\n百花繚乱研究所と「エイゼルベット」によりある世界からあらゆる\"観測\"を経て誕生した、特殊な十六進数を持つナンバーテールズ同位体。百花繚乱研究所にて研究開発の一要因として活動している。",
