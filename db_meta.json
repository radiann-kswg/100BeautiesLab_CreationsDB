{
  "CreationWorks": {
    "#Works_NumberTales": {
      "Title": "ナンバーテールズ",
      "Title_EN": "NumberTales",
      "Works_Summary": "九蓮国にあるヴェンチャーラボ「百花繚乱研究所」で零(レイ)と百(ハゲム)が手掛けている妖獣型生活支援ポータブルヒューマノイド。\n主に数字や数秘に基づいた妖獣型のキャラクターが存在する。",
      "$Def_Index": { "hashTag": "Num", "valType": "#Number\n#String" }
    },
    "#Works_FLInvestigator78": {
      "Title": "運命線探偵78",
      "Title_EN": "the Fate-Line Investigator 78",
      "OldTitles": [
        {
          "Title": "運命線探偵OCTOGINTA",
          "Title_EN": "OCTOGINTA the Destiny Detectives",
          "ArchivedYear": 2024
        }
      ],
      "Works_Summary": "英皇国と九蓮国にある異能調査組織「特殊探偵団セブンティエイト」に所属する少年少女。\n主にタロットカードに基づいた能力の憑依が可能なキャラクターが存在する。",
      "$Def_Index": {
        "hashTag": "Card",
        "$valType": [
          { "hashTag": "Stoat", "valType": "#ListIndex" },
          { "hashTag": "Num", "valType": "#Number" }
        ]
      }
    },
    "#Works_ShouArRiders": {
      "Title": "獣爾騎兵",
      "Title_EN": "Shou'ar Riders",
      "Works_Summary": "龍天国にある山月病(変化病)対策組織「獣爾騎兵」に所属する獣人型改造人間。\n主に十二支などの動物に基づいた獣人キャラクターが存在する。",
      "$Def_Index": {
        "hashTag": "BeastType",
        "$valType": [{ "hashTag": "Beast", "valType": "#ListIndex" }]
      }
    },
    "#Works_SinisterChangingGirls": {
      "Title": "豹変系女子",
      "Title_EN": "Sinister Changing Girls",
      "Works_Summary": "創作世界の各国を放浪している謎多き少女。\n主に七つの大罪や八方位などに基づいた二面性と特徴を持つガーリッシュな８人のキャラクターからなる。",
      "$Def_Index": { "hashTag": "Drc", "$valType": "#String" }
    },
    "#Works_PastDivers": {
      "Title": "パストダイヴァー",
      "Title_EN": "PastDivers",
      "Works_Summary": "九蓮国の国家技術と国防を担う「夜月機関」に所属する特殊技術者。\n主に和暦などに基づいたキャラクターが存在する。",
      "$Def_Index": [
        { "hashTag": "Lunar", "$valType": "#ListIndex" },
        { "hashTag": "Generation", "$valType": "#Number" }
      ]
    },
    "#Works_DestinyFoxsRecords": {
      "Title": "運命線狐の記録\nフィジカル9",
      "Title_EN": "Destiny Fox's Records\nPhysical 9",
      "OldTitles": [
        {
          "Title": "運命線探偵上官ラジアンの記録",
          "Title_EN": "Destiny Detective Superintendent: RadianN's Records",
          "ArchivedYear": 2021
        }
      ],
      "Works_Summary": "弊創作を執筆している「ラジアン」の仲間たち。\n主に科学単位や数学用語に基づいた獣人のキャラクターからなる。\nちなみに、当タイトルのいう「ラジアン」とは作者の２代目代理のことである。",
      "$Def_Index": { "hashTag": "Unit", "$valType": "#String" }
    }
  },
